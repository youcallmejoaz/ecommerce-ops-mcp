# --- Claude API (briefing narrative, campaign copy, demo chat page) ---
# Leave empty to run on built-in test responses (clearly labelled in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Storage ---
DATABASE_PATH=./data/store.db
# Pin the store's "today" (YYYY-MM-DD) for reproducible demos. Empty = real date.
STORE_TODAY=
LIMITS_PATH=./config/limits.json

# --- Admin login: comma separated user:password pairs ---
ADMIN_USERS=owner:change-me,ops:change-me
SESSION_SECRET=replace-with-32+-random-characters

# --- MCP over HTTP (/api/mcp): comma separated client:token pairs.
# Client names map to scope sets in config/limits.json.
MCP_TOKENS=default:replace-with-a-long-random-token
# Client used by the local stdio server (npm run mcp)
MCP_CLIENT=default

# --- Adapters: mock (default) | shopify / klaviyo ---
STORE_ADAPTER=mock
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
EMAIL_ADAPTER=mock
KLAVIYO_API_KEY=
KLAVIYO_FROM_EMAIL=
KLAVIYO_FROM_LABEL=
# JSON map of segment id -> Klaviyo list/segment id, e.g. {"vip":"AbC123"}
KLAVIYO_AUDIENCE_MAP=
